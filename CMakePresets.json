{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_FLAGS": "-std=c++26 -freflection",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
